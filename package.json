{
  "name": "student-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Student Portal System with Trend-Based Academic Risk and Intervention Tracking — DepEd Progressive Senior High School, Bacoor City",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build && npm --prefix backend ci --omit=dev",
    "start": "node backend/server.js",
    "migrate:up": "npm --prefix backend run migrate:up",
    "migrate:down": "npm --prefix backend run migrate:down",
    "seed:admin": "npm --prefix backend run seed:admin",
    "reset:password": "npm --prefix backend run reset:password --",
    "seed:sample": "npm --prefix backend run seed:sample",
    "seed:demo-data": "npm --prefix backend run seed:demo-data",
    "test": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  }
}

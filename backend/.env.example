# Copy this file to .env and adjust values for your machine.
# .env is gitignored — never commit real credentials.

PORT=5000

# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=student_portal

# Set to "true" to auto-start a local embedded PostgreSQL server on `npm run dev`
# (useful when no system-wide PostgreSQL install is available on this machine).
# Set to "false" once a real PostgreSQL server is installed/running and PG* vars above point to it.
USE_EMBEDDED_DB=true

# Used only by node-pg-migrate (migrations). Must stay in sync with the PG* values above.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/student_portal

# Auth — generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# How long a sign-in lasts when "Remember me on this device" is ticked.
# Ending a session early does not depend on this: deactivating an account,
# or changing/resetting its password, signs it out on its next request.
# REMEMBER_ME_EXPIRES_IN=30d

# Password reset by emailed 6-digit code: how long a code lasts, and how
# many wrong tries burn it (a code is safe only because guessing is cut off).
# RESET_CODE_TTL_MINUTES=15
# RESET_CODE_MAX_ATTEMPTS=5

# Used once by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=admin@studentportal.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

# DEV ONLY, optional — when set, every newly-created account gets this fixed
# password instead of a random generated one (still forces a password change
# on first login either way). Leave unset in any real/shared deployment.
# DEV_PLACEHOLDER_PASSWORD=TempPass123!

# Email — used by the forgot-password flow only.
#
# With NONE of the transports below configured, the portal tells users that
# reset by email isn't available and points them at the registrar's manual
# reset, rather than claiming to have sent something it cannot send.
#
# Order when several are set: Brevo, then SMTP, then Resend.
#
# BREVO — the one that works on the Railway deployment. Railway's
# Hobby/Free plans block outgoing SMTP, but not HTTPS, and Brevo sends over
# an HTTPS API. Free plan: 300 emails a day, to any recipient, no domain
# needed. Setup:
#   1. Create a free account at https://www.brevo.com
#   2. Senders (Senders, Domains & Dedicated IPs) -> add the address that
#      will send (e.g. the group's or the school's Gmail), then click the
#      link in the confirmation email Brevo sends to it.
#   3. SMTP & API -> API Keys -> Generate a new API key, and copy it.
#   4. Set BREVO_API_KEY (the API key, starting xkeysib- — NOT the SMTP
#      key, which starts xsmtpsib-; permission "Transactional email: All")
#      and BREVO_SENDER_EMAIL (exactly the verified address) on the
#      Railway service.
#   5. `railway run npm run check:email -- you@example.com` sends a test.
# A gmail.com (or other free-mail) sender cannot be authenticated, so Brevo
# rewrites it to name@<id>.brevosend.com: mail arrives but may land in spam.
# Sending from a domain the school owns removes that.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=DepEd Progressive SHS Student Portal
#
# RESEND_API_KEY — an alternative to SMTP above. Get one at
# https://resend.com. IMPORTANT: the shared onboarding@resend.dev sender
# delivers ONLY to the address that owns the Resend account; every other
# recipient is refused with a 403. Reaching students at their own addresses
# therefore needs a verified sending domain, which this school does not
# have — which is why SMTP is the configured path and this is the fallback.
# RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP — reaches a student at their own personal address, but needs a host
# that allows outbound SMTP (Railway Hobby/Free does NOT: the connection
# times out after two minutes — use Brevo above there).
#
# For a Gmail account:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=the.schools.account@gmail.com
#   SMTP_PASS=  a 16-character App Password, NOT the account password.
#               Generate one at https://myaccount.google.com/apppasswords —
#               the page only appears once 2-Step Verification is on for
#               that account.
#   SMTP_FROM=the.schools.account@gmail.com   (defaults to SMTP_USER)
#
# All of SMTP_HOST, SMTP_USER and SMTP_PASS must be present: a half-filled
# set counts as "not configured" rather than failing at send time, when
# somebody is already waiting for a link. Gmail allows roughly 500
# recipients a day, far above this school's needs.
#
# Paste the App Password with or without the spaces Google shows it in —
# both work. But note that "configured" is NOT the same as "working": these
# three being non-empty is all the app can check by itself, so a mistyped
# password still switches the flow on and then fails at send time. To find
# that out before a user does:
#
#   npm run check:email                      config + a real login to the server
#   npm run check:email -- you@example.com   the above, then a real test message
#
# It never prints the password.
#
# If BOTH SMTP and Resend are configured, SMTP is used — see the note in
# services/emailService.js about who Resend's free sender can reach. If
# Brevo is configured too, Brevo is used before either.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# EMAIL_DEV_FALLBACK — development only. Writes the reset link to the server
# console instead of emailing it, so the flow stays testable locally without a
# provider. Deliberately opt-in: a deployment that merely forgot the API key
# must not silently log password-reset links and tell users they were sent.
# EMAIL_DEV_FALLBACK=true

# Base URL the frontend is served from. No longer needed for password reset,
# which emails a code rather than a link (2026-11-15); kept for reference.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Deployment-only settings (see DEPLOYMENT.md). Every one of these is unset or
# false for local development, which is why `npm run dev` behaves exactly as it
# always has.
# -----------------------------------------------------------------------------

# "true" makes Express serve frontend/dist itself, so the API and the frontend
# are one service on one origin. Leave unset locally: Vite serves the frontend
# with hot reload and proxies /api to this server.
# SERVE_FRONTEND=true

# Only needed if the frontend is hosted SEPARATELY from the API. Naming the one
# allowed origin keeps CORS closed to everyone else. With SERVE_FRONTEND=true
# there is no cross-origin request at all and this stays unset.
# ALLOWED_ORIGIN=https://your-app.up.railway.app

# Where uploaded announcement attachments are written. A deployed container's
# filesystem is wiped on every redeploy, so point this at a mounted volume.
# Unset locally, where it defaults to backend/uploads (gitignored).
# UPLOADS_ROOT=/data

# Set to "require" ONLY when connecting to a database over a public host that
# demands TLS. Over a provider's private network (Railway's
# *.railway.internal) leave it unset — see config/db.js.
# PGSSLMODE=require

# Login attempts allowed per IP per window. Unset or malformed gives the
# production default of 10 per 15 minutes; the value is only ever raised, and
# only on a development machine, so that scripted work (the demo seed signs
# in as nine staff accounts in a row) does not exhaust the real limit.
# NEVER set this on a deployment. See backend/config/rateLimits.js.
# LOGIN_RATE_LIMIT_MAX=300

# The window the login limit above is measured over, in minutes. Same rule:
# unset or malformed gives the production default of 15.
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Below what daily-attendance rate a student picks up the low-attendance risk
# factor, as a percentage (0-100). Defaults to 90.
#
# This is THE value the client still owes us — CLAUDE.md records it as
# "[TBD]% pending from the client (DepEd Order referenced but not yet
# provided)". 90 is a commonly-cited DepEd expectation used as a stand-in.
# When the real number arrives, set it here; no code changes, no redeploy of
# logic. A malformed value falls back to 90 with a warning rather than
# silently disabling the factor. See backend/config/riskConfig.js.
#
# NOTE: changing this does NOT recompute risk assessments already stored.
# They are recalculated when that student's next grade is finalized or
# attendance is recorded.
# ATTENDANCE_RISK_THRESHOLD=90

# The timezone the school is actually in — used to decide what "today" is
# when resolving the current grading period. Defaults to Asia/Manila.
# Only change this if the school moves. See backend/utils/schoolDate.js.
# SCHOOL_TIMEZONE=Asia/Manila

# Set to true ONLY when the app sits behind a reverse proxy that is not
# detected automatically (production sets this itself). It makes Express
# trust X-Forwarded-For, which is what lets per-IP rate limiting work behind
# a proxy — and which a directly-reachable server must never do, since any
# client could then forge the header. See backend/app.js.
# TRUST_PROXY=true

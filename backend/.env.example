# Copy this file to .env and adjust values for your machine.
# .env is gitignored — never commit real credentials.

PORT=5000

# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=student_portal

# Set to "true" to auto-start a local embedded PostgreSQL server on `npm run dev`
# (useful when no system-wide PostgreSQL install is available on this machine).
# Set to "false" once a real PostgreSQL server is installed/running and PG* vars above point to it.
USE_EMBEDDED_DB=true

# Used only by node-pg-migrate (migrations). Must stay in sync with the PG* values above.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/student_portal

# Auth — generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Used once by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=admin@studentportal.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

# DEV ONLY, optional — when set, every newly-created account gets this fixed
# password instead of a random generated one (still forces a password change
# on first login either way). Leave unset in any real/shared deployment.
# DEV_PLACEHOLDER_PASSWORD=TempPass123!

# Email (Resend) — used by the forgot-password flow only.
#
# With NEITHER of the two settings below, the portal tells users that reset by
# email isn't available and points them at the registrar's manual reset, rather
# than claiming to have sent something it cannot send.
#
# RESEND_API_KEY — a real provider. Get one at https://resend.com. Note that
# the shared onboarding@resend.dev sender is for testing; sending to arbitrary
# recipients (students' personal addresses) normally requires verifying a
# sending domain, which this school may not have. Test with one real student
# address before relying on it.
# RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# EMAIL_DEV_FALLBACK — development only. Writes the reset link to the server
# console instead of emailing it, so the flow stays testable locally without a
# provider. Deliberately opt-in: a deployment that merely forgot the API key
# must not silently log password-reset links and tell users they were sent.
# EMAIL_DEV_FALLBACK=true

# Base URL the frontend is served from, used to build the reset-password link.
# In a single-service deployment this is the app's own public URL.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Deployment-only settings (see DEPLOYMENT.md). Every one of these is unset or
# false for local development, which is why `npm run dev` behaves exactly as it
# always has.
# -----------------------------------------------------------------------------

# "true" makes Express serve frontend/dist itself, so the API and the frontend
# are one service on one origin. Leave unset locally: Vite serves the frontend
# with hot reload and proxies /api to this server.
# SERVE_FRONTEND=true

# Only needed if the frontend is hosted SEPARATELY from the API. Naming the one
# allowed origin keeps CORS closed to everyone else. With SERVE_FRONTEND=true
# there is no cross-origin request at all and this stays unset.
# ALLOWED_ORIGIN=https://your-app.up.railway.app

# Where uploaded announcement attachments are written. A deployed container's
# filesystem is wiped on every redeploy, so point this at a mounted volume.
# Unset locally, where it defaults to backend/uploads (gitignored).
# UPLOADS_ROOT=/data

# Set to "require" ONLY when connecting to a database over a public host that
# demands TLS. Over a provider's private network (Railway's
# *.railway.internal) leave it unset — see config/db.js.
# PGSSLMODE=require

# Login attempts allowed per IP per window. Unset or malformed gives the
# production default of 10 per 15 minutes; the value is only ever raised, and
# only on a development machine, so that scripted work (the demo seed signs
# in as nine staff accounts in a row) does not exhaust the real limit.
# NEVER set this on a deployment. See backend/config/rateLimits.js.
# LOGIN_RATE_LIMIT_MAX=300
